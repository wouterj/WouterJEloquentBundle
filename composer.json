{
    "name": "wouterj/eloquent-bundle",
    "description": "Implementing the Eloquent ORM into Symfony",
    "authors": [{ "name": "Wouter de Jong", "email": "wouter@wouterj.nl" }],
    "license": "MIT",
    "type": "symfony-bundle",

    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0 || ^12.0",
        "illuminate/events": "^11.0 || ^12.0",
        "illuminate/console": "^11.0 || ^12.0",
        "laravel/serializable-closure": "^1.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "jdorn/sql-formatter": "^1.2.17"
    },
    "require-dev": {
        "doctrine/annotations": "1.*",
        "symfony/maker-bundle": "^1.49",
        "mockery/mockery": "^1.6",
        "symfony/console": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/finder": "^7.0",
        "symfony/yaml": "^7.0",
        "symfony/form": "^7.0",
        "symfony/phpunit-bridge": "^7.0",
        "symfony/browser-kit": "^7.0",
        "symfony/dom-crawler": "^7.0",
        "symfony/validator": "^7.0",
        "symfony/security-bundle": "^7.0",
        "symfony/twig-bundle": "^7.0",
        "symfony/twig-bridge": "^7.0",
        "symfony/var-dumper": "^7.0",
        "symfony/process": "^7.0",
        "twig/twig": "^2.0 || ^3.0",
        "vimeo/psalm": "^5.0 || ^6.0",
        "psalm/plugin-symfony": "^5.0"
    },
    "conflict": {
        "nesbot/carbon": "<2.63"
    },

    "autoload": {
        "psr-4": { "WouterJ\\EloquentBundle\\": "src" },
        "files": ["src/functions.php"]
    },
    "autoload-dev": {
        "psr-4": { "WouterJ\\EloquentBundle\\": "tests", "": "tests/Functional/app/src" },
        "classmap": ["tests/Functional/app/migrations", "tests/Functional/app/TestKernel.php"]
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
